    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/baclib/generic-bacnet-types.git"
    },
    "dependencies": {
        "handlebars": "^4.7.8"
    },
    "bugs": {
        "url": "https://github.com/baclib/generic-bacnet-types/issues"
    },
    "homepage": "https://github.com/baclib/generic-bacnet-types#readme",
    "engines": {
        "node": ">=22"
    }
