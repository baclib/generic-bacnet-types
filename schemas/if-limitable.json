{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://baclib.github.io/schemas/if-limitable.json",
    "title": "BAClib If-Limitable Applicator",
    "description": "Conditional schema that applies constraints based on the base type. Supports range constraints for unsigned/enumerated, min/max for signed/float/double, and length constraints for octetstring/charstring/bitstring.",
    "type": "object",
    "allOf": [
        {
            "if": {
                "properties": {
                    "base": {
                        "enum": [
                            "unsigned",
                            "enumerated"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "minimum": {
                        "anyOf": [
                            {
                                "type": "integer",
                                "minimum": 0
                            },
                            {
                                "type": "string",
                                "pattern": "^[0-9]+$"
                            }
                        ]
                    },
                    "maximum": {
                        "anyOf": [
                            {
                                "type": "integer",
                                "minimum": 0
                            },
                            {
                                "type": "string",
                                "pattern": "^[0-9]+$"
                            }
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "base": {
                        "const": "integer"
                    }
                }
            },
            "then": {
                "properties": {
                    "minimum": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "string",
                                "pattern": "^-?[0-9]+$"
                            }
                        ]
                    },
                    "maximum": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "string",
                                "pattern": "^-?[0-9]+$"
                            }
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "base": {
                        "enum": [
                            "real",
                            "double"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "minimum": {
                        "type": "number"
                    },
                    "maximum": {
                        "type": "number"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "base": {
                        "enum": [
                            "octet-string",
                            "character-string",
                            "bit-string"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "length": {
                        "$ref": "./reuse-non-negative-integer-length.json"
                    }
                }
            }
        }
    ]
}